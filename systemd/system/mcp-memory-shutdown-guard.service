[Unit]
Description=Wait for MCP Memory Session Review before Shutdown
DefaultDependencies=no
After=network.target network-online.target NetworkManager.service nss-lookup.target user@1000.service
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/true
ExecStop=/usr/local/bin/mcp-memory-shutdown-guard.sh nitro
TimeoutStopSec=130

[Install]
WantedBy=multi-user.target
